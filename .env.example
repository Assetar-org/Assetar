# Local frontend preview. In production compose.yaml forces cms mode.
NUXT_CONTENT_SOURCE=snapshot
NUXT_STRAPI_URL=http://127.0.0.1:1337
NUXT_STRAPI_TOKEN=
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_STRAPI_MEDIA_URL=http://localhost:1337

# Docker Compose / Coolify. Replace all example secrets before first deployment.
SITE_PUBLIC_URL=http://localhost:3000
CMS_PUBLIC_URL=http://localhost:1337
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
# Enable only for the first migration, then turn off.
SEED_CONTENT=false
